# Copy to the project root as .env.office. Do not commit credentials.
ONLYOFFICE_JWT_SECRET=replace-with-at-least-32-random-characters
# Password login is disabled by auth: "none" in config.json.
# To enable it: change that mapping to auth: "basic", add usernameEnv/passwordEnv,
# and uncomment the corresponding Compose environment entries.
# OFFICE_MAIN_USERNAME=opencode
# OFFICE_MAIN_PASSWORD=replace-with-a-strong-password
# OFFICE_SECOND_USERNAME=opencode
# OFFICE_SECOND_PASSWORD=replace-with-a-strong-password
# Actual directories on the Docker host; these are independent for each service.
OFFICE_MAIN_PROJECTS_PATH=/replace/with/service-a/host-directory
OFFICE_SECOND_PROJECTS_PATH=/replace/with/service-b/host-directory
# These bindings are for a reverse proxy ON THE SAME HOST, not browser URLs.
OFFICE_BIND_ADDRESS=127.0.0.1
ONLYOFFICE_PORT=18092
OFFICE_BRIDGE_PORT=18093
# Fixed release; upgrades require an explicit version change.
ONLYOFFICE_IMAGE=onlyoffice/documentserver:10.0.0
